<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- spring-boot-starter-parent nos da las versiones correctas de todas
         las dependencias de Spring sin tener que escribirlas a mano
         (evita conflictos de versiones entre librerias). -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.sgb</groupId>
    <artifactId>sgb-servicio-cita-api</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>SGB - Modulos Servicio y Cita (API REST)</name>
    <description>
        Evidencia GA7-220501096-AA3-EV01 - Codificacion de modulos del
        software. API REST de los modulos Servicio y Cita del proyecto
        Sistema Gestion Barberia (SGB), construida con Spring Boot y
        Spring Data JPA, conectada a la misma base de datos MySQL 'sgb'
        que ya usan los modulos de Login y Citas (version Servlets/JSP)
        entregados en la Evidencia GA7-220501096-AA2-EV02.
    </description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Spring Web: permite crear controladores REST (@RestController)
             que exponen los modulos como endpoints HTTP (API). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA: permite mapear clases Java a tablas de la
             base de datos (entidades) y hacer consultas sin escribir SQL
             a mano, usando Hibernate por debajo. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Conector JDBC oficial de MySQL (el mismo que ya usa el
             proyecto de la Evidencia AA2-EV02). -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok: genera automaticamente getters, setters, constructores,
             etc. a partir de anotaciones (@Data), para no escribir codigo
             repetitivo en las entidades. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Validacion de datos de entrada (@NotNull, @NotBlank, etc.)
             en los objetos que llegan por la API. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- jBCrypt: hash de contrasenas con BCrypt (RNF04/RNF06 y modelo
             entidad-relacion: "Hash bcrypt de la contrasena"). Libreria
             pequena y sin dependencias; ya estaba descargada en el
             repositorio Maven local (~/.m2). Se usa para verificar el login
             y para migrar, en el primer inicio de sesion exitoso, las
             contrasenas que todavia estan en texto plano. -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
